string(JSON n LENGTH "${json}" graph vertices)
if(NOT n EQUAL 3)
  message(FATAL_ERROR "conversion lost an isolated vertex")
endif()
file(READ "${SOURCE}/graphs/graph13.csv" original)
file(WRITE "${BINARY}/hardlink-input.csv" "${original}")
file(REMOVE "${BINARY}/hardlink-alias.json")
file(CREATE_LINK "${BINARY}/hardlink-input.csv" "${BINARY}/hardlink-alias.json" RESULT link_result)
if(NOT link_result STREQUAL "0")
  message(FATAL_ERROR "cannot prepare hard-link regression: ${link_result}")
endif()
run_case(2 solve "${BINARY}/hardlink-input.csv" --json "${BINARY}/hardlink-alias.json")
file(READ "${BINARY}/hardlink-input.csv" preserved)
if(NOT preserved STREQUAL original)
  message(FATAL_ERROR "hard-linked output overwrote the input")
endif()
file(WRITE "${BINARY}/shared-output.json" "existing output")
file(REMOVE "${BINARY}/shared-output.html")
file(CREATE_LINK "${BINARY}/shared-output.json" "${BINARY}/shared-output.html")
run_case(2 solve "${SOURCE}/graphs/graph13.csv" --json "${BINARY}/shared-output.json" --report "${BINARY}/shared-output.html")
# Decomposition construction options.
run_case(0 solve "${SOURCE}/graphs/graph13.csv" --td-method exact --json "${BINARY}/exact.json")
file(READ "${BINARY}/exact.json" json)
string(JSON width_status GET "${json}" decomposition width_status)
string(JSON width GET "${json}" decomposition width)
if(NOT width_status STREQUAL "optimal" OR NOT width EQUAL 4)
  message(FATAL_ERROR "Wagner graph must have proven optimal width 4")
endif()
run_case(0 solve "${SOURCE}/graphs/graph13.csv" --td-method minfill --no-simplify --no-preprocess --write-td "${BINARY}/raw-td.csv")
run_case(0 validate-td "${SOURCE}/graphs/graph13.csv" "${BINARY}/raw-td.csv")
if(NOT LAST_OUTPUT MATCHES "bags=8")
  message(FATAL_ERROR "raw min-fill must keep one bag per vertex: ${LAST_OUTPUT}")
endif()
run_case(0 solve "${SOURCE}/graphs/graph13.csv" --td "${BINARY}/raw-td.csv" --simplify-td --json "${BINARY}/simplified.json")
file(READ "${BINARY}/simplified.json" json)
string(JSON merged GET "${json}" decomposition merged_bags)
if(merged EQUAL 0)
  message(FATAL_ERROR "--simplify-td must merge contained bags of the raw decomposition")
