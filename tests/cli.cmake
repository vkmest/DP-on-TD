function(run_case expected)
  execute_process(COMMAND "${EXE}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${code}" STREQUAL "${expected}")
    message(FATAL_ERROR "command ${ARGN}: expected ${expected}, got ${code}: ${output} ${error}")
  endif()
  set(LAST_OUTPUT "${output}" PARENT_SCOPE)
endfunction()
run_case(0 --help)
if(NOT LAST_OUTPUT MATCHES "td3color solve")
  message(FATAL_ERROR "help must explain how to solve a graph")
endif()
run_case(0 solve "${SOURCE}/graphs/graph13.csv" --no-preprocess --report "${BINARY}/test-report.html" --json "${BINARY}/test-result.json" --write-td "${BINARY}/test-td.csv")
if(NOT LAST_OUTPUT MATCHES "COLORABLE")
  message(FATAL_ERROR "missing positive verdict")
endif()
file(READ "${BINARY}/test-result.json" json)
string(JSON status GET "${json}" status)
string(JSON preparation_ms GET "${json}" stats preparation_ms)
if(NOT status STREQUAL "COLORABLE")
  message(FATAL_ERROR "incorrect JSON status")
endif()
run_case(0 validate-td "${SOURCE}/graphs/graph13.csv" "${BINARY}/test-td.csv")
run_case(0 solve "${SOURCE}/graphs/graph13.csv" --td "${BINARY}/test-td.csv")
run_case(1 solve "${SOURCE}/graphs/graph07.csv")
run_case(3 solve "${SOURCE}/graphs/graph07.csv" --memory-mib 0)
run_case(2 solve "${SOURCE}/graphs/graph07.csv" --bogus)
run_case(2 solve "${SOURCE}/graphs/graph07.csv" --time-limit nan)
run_case(2 solve "${SOURCE}/graphs/graph07.csv" --memory-mib -1)
run_case(2 solve "${SOURCE}/graphs/graph07.csv" --json "${SOURCE}/graphs/graph07.csv")
run_case(2 solve "${SOURCE}/graphs/does-not-exist.csv")
file(WRITE "${BINARY}/legacy.txt" "3\n4 5 6\n1 2\n")
